# Optional. Principal-bound demo credentials and a central AES-GCM key are generated in .keys/.
REMATCH_API_URL=http://127.0.0.1:8000
# Hosted backend: exact Vercel/custom-domain origins, comma-separated. No wildcard.
# Leave empty for local development.
REMATCH_ALLOWED_ORIGINS=
# Set true on the HTTPS-hosted backend; leave false for local HTTP.
REMATCH_COOKIE_SECURE=false
# Optional persistent disk paths on Render (configure only after attaching a disk):
# REMATCH_RUNTIME=/var/data/runtime
# REMATCH_KEYS=/var/data/keys
# Server-side only. Public/synthetic study sources only; no patient data is sent.
OPENAI_API_KEY=
# Configure a model supporting the Responses API and Structured Outputs.
OPENAI_MODEL=
DEMO_LISTING_FEE=100
DEMO_ONBOARDING_CREDIT=5
