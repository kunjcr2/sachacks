# Optional. The demo generates independent local service credentials in .keys/.
HUB_URL=http://127.0.0.1:8000
SYNC_INTERVAL_SECONDS=5
MIN_CELL_SIZE=1
EXTRACTION_MODE=curated
# Only public trial criteria are sent to OpenAI. Never patient records.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional per-process clinic override; never reuse a key across clinics.
CLINIC_IDENTITY_KEY_B64=
CLINIC_IDENTITY_KEY_ID=clinic-a-v1
